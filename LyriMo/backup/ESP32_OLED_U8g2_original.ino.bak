/*
 * ============================================================
 *  ESP32 DevKit + OLED SSD1306 128x64  —  versi U8g2
 * ============================================================
 *
 *  WIRING (sama seperti versi Adafruit):
 *    OLED VCC -> 3V3
 *    OLED GND -> GND
 *    OLED SDA -> GPIO21
 *    OLED SCL -> GPIO22
 *
 *  BOARD : ESP32 Dev Module   |   PORT : COM6   |   BAUD : 115200
 *  Library : U8g2 by oliver (v2.37.1) - sudah terinstall
 *
 *  Kalau OLED-mu ternyata alamat I2C-nya 0x3D, aktifkan baris
 *  u8g2.setI2CAddress(0x3D * 2); di setup().
 * ============================================================
 */

#include <Arduino.h>
#include <U8g2lib.h>
#include <Wire.h>

// Full buffer + hardware I2C
// parameter: rotation, reset, clock(SCL)=22, data(SDA)=21
U8G2_SSD1306_128X64_NONAME_F_HW_I2C u8g2(
    U8G2_R0, U8X8_PIN_NONE, /* clock=*/22, /* data=*/21);

// ---------- State layar ----------
enum Screen { SCREEN_SPLASH, SCREEN_INFO, SCREEN_WAVE };
Screen screen = SCREEN_SPLASH;
uint32_t screenStart = 0;
const uint32_t SCREEN_MS = 3000;

// ---------- Animasi gelombang ----------
float phase = 0;

void drawSplash() {
  u8g2.clearBuffer();

  u8g2.setFont(u8g2_font_ncenB14_tr);
  u8g2.drawStr(18, 10, "ESP32");

  u8g2.setFont(u8g2_font_6x10_tf);
  u8g2.drawStr(30, 30, "U8g2 READY");

  u8g2.drawFrame(0, 0, 128, 64);
  u8g2.drawLine(6, 45, 121, 45);

  u8g2.setFont(u8g2_font_5x7_tf);
  u8g2.drawStr(18, 52, "SSD1306 128x64 I2C");

  u8g2.sendBuffer();
}

void drawInfo() {
  u8g2.clearBuffer();
  u8g2.setFont(u8g2_font_6x10_tf);

  char line[32];

  u8g2.drawStr(0, 0, "ESP32 + U8g2");

  snprintf(line, sizeof(line), "Chip : %s", ESP.getChipModel());
  u8g2.drawStr(0, 12, line);

  snprintf(line, sizeof(line), "Core : %d x %d MHz", ESP.getChipCores(),
           ESP.getCpuFreqMHz());
  u8g2.drawStr(0, 24, line);

  snprintf(line, sizeof(line), "Flash: %d MB", ESP.getFlashChipSize() / (1024 * 1024));
  u8g2.drawStr(0, 36, line);

  snprintf(line, sizeof(line), "Heap : %d KB", ESP.getFreeHeap() / 1024);
  u8g2.drawStr(0, 48, line);

  u8g2.sendBuffer();
}

void drawWave() {
  u8g2.clearBuffer();

  // header
  u8g2.setFont(u8g2_font_5x7_tf);
  char head[32];
  snprintf(head, sizeof(head), "uptime %lus", (unsigned long)(millis() / 1000));
  u8g2.drawStr(0, 0, head);
  u8g2.drawHLine(0, 9, 128);

  // gelombang sinus
  for (int x = 0; x < 128; x++) {
    float y = 36.0 + 16.0 * sin((x / 128.0 * 2 * PI) + phase);
    u8g2.drawPixel(x, (int)y);
  }

  // bola yang mengikuti gelombang
  int bx = (int)((millis() / 12) % 128);
  float by = 36.0 + 16.0 * sin((bx / 128.0 * 2 * PI) + phase);
  u8g2.drawDisc(bx, (int)by, 3, U8G2_DRAW_ALL);

  u8g2.setFont(u8g2_font_5x7_tf);
  u8g2.drawStr(0, 56, "U8g2 wave demo");

  u8g2.sendBuffer();

  phase += 0.10;
  if (phase > 2 * PI) phase -= 2 * PI;
}

void setup() {
  Serial.begin(115200);
  delay(300);

  Serial.println();
  Serial.println("ESP32 + U8g2 start...");

  // u8g2.begin() sudah memanggil Wire.begin() dengan pin dari constructor
  u8g2.begin();

  // Kalau OLED pakai alamat 0x3D, buka komentar baris ini:
  // u8g2.setI2CAddress(0x3D * 2);

  u8g2.setContrast(255);
  u8g2.setFontPosTop();

  Serial.print("Chip : ");
  Serial.println(ESP.getChipModel());
  Serial.println("OLED init selesai.");

  screenStart = millis();
  drawSplash();
}

void loop() {
  // ganti layar tiap SCREEN_MS
  if (millis() - screenStart > SCREEN_MS) {
    screenStart = millis();
    screen = (Screen)((screen + 1) % 3);
  }

  switch (screen) {
    case SCREEN_SPLASH: drawSplash(); break;
    case SCREEN_INFO:   drawInfo();   break;
    case SCREEN_WAVE:   drawWave();   break;
  }

  delay(20);
}
